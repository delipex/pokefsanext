# ==============================================================
# Liga Atlântica TCG (PokéFSANext) - Variáveis de Ambiente
# ==============================================================

# 1. Modo Local (Padrão para Desenvolvimento Offline)
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# 2. Modo Produção na Vercel (Banco Gratuito no Turso Cloud)
# Crie um banco em https://turso.tech e configure no painel da Vercel:
# TURSO_DATABASE_URL="libsql://sua-liga-username.turso.io"
# TURSO_AUTH_TOKEN="seu-token-gerado-no-turso"
