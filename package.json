    "pr:merge": "powershell -ExecutionPolicy Bypass -File ./scripts/git-flow.ps1 merge",
    "pr:sync": "powershell -ExecutionPolicy Bypass -File ./scripts/git-flow.ps1 sync",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.2",
