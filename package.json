{
  "name": "pokefsanext",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "branch:new": "powershell -ExecutionPolicy Bypass -File ./scripts/git-flow.ps1 new",
